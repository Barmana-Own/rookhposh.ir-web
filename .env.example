NEXT_PUBLIC_SITE_URL=https://rookhposh.ir
# Optional build-time Google Search Console verification token.
# Leave empty until an owner creates a verified property and supplies its token.
GOOGLE_SITE_VERIFICATION=
# Optional server-only, read-only CMS endpoint. Expected resources: /posts and /posts/:slug.
BLOG_CONTENT_API_URL=https://cms.rookhposh.ir/api/public
# Server-only HMAC secret shared with PUBLIC_REVALIDATION_SECRET in the CMS.
BLOG_REVALIDATION_SECRET=replace-with-a-separate-long-random-value
